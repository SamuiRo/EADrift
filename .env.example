# ─── Binance USD-M Futures ────────────────────────────────────────────────────
# Для SHADOW достатньо ключа ЛИШЕ З ПРАВОМ ЧИТАННЯ: бот бере ціни, баланс і
# позиції, але ордерів не шле. Торгові права вмикайте тільки перед live.
# Withdrawal ніколи не вмикайте. Бажано обмежити ключ IP сервера.
BINANCE_API_KEY=<your-binance-api-key>
BINANCE_SECRET_KEY=<your-binance-secret-key>
BINANCE_TESTNET=false

# ─── Telegram Bot API (команди, сповіщення, підтвердження) ────────────────────
TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>
TELEGRAM_ADMIN_CHAT_ID=<your-numeric-chat-id>

# ─── Telegram MTProto (читання каналів сигналів) ──────────────────────────────
# Без них бот стартує, але канали не слухає.
TELEGRAM_API_ID=<api-id-from-my.telegram.org>
TELEGRAM_API_HASH=<api-hash-from-my.telegram.org>
TELEGRAM_SESSION_STRING=<gramjs-session-string>

# Канали-джерела: ім'я:ідентифікатор[:парсер] через кому.
# Ім'я потрапляє в статистику як джерело сигналу — НЕ перейменовуйте канал
# пізніше, інакше його історія розділиться на дві частини.
# Ідентифікатор: -100xxxxxxxxxx або @username. Парсер за замовчуванням: ggshot.
# Акаунт, для якого створено сесію, мусить бути підписаний на кожен канал.
SIGNAL_CHANNELS=ggshot:<-100xxxxxxxxxx>,kira_ict:-1001231491534:kira_ict

# Застаріле: один канал. Працює, якщо SIGNAL_CHANNELS порожній.
# TELEGRAM_SIGNAL_CHANNEL_ID=<-100xxxxxxxxxx>
# TELEGRAM_SIGNAL_CHANNEL_NAME=ggshot

# ─── Режим і капітал ──────────────────────────────────────────────────────────
# Режим після кожного старту процесу: SHADOW | CONFIRM_ONLY | SEMI_AUTO | FULL_AUTO | PAUSED
# SHADOW — проганяє кожен сигнал через усі фільтри й записує рішення, не торгуючи.
STARTUP_TRADING_MODE=SHADOW

# Максимум капіталу, з яким працює бот. Ризик, розмір і маржа рахуються від
# min(баланс, CAPITAL_CAP_USDT) — кошти понад межу бот не використовує.
CAPITAL_CAP_USDT=1000

# Скільки позицій одночасно. Капітал ділиться на стільки маржинальних слотів.
MAX_OPEN_POSITIONS=3

# ─── Поведінка ────────────────────────────────────────────────────────────────
MONITOR_INTERVAL_MS=5000
CONFIRM_MAX_PRICE_MOVE_PCT=0.005
LOG_LEVEL=info

# Необов'язково: інший файл SQLite (типово src/data/trading.db)
# EADRIFT_DB_PATH=/var/lib/eadrift/trading.db
